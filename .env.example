# Copy to .env, which is never versioned, and fill every secret. Names and placeholders only.
# In development the keys come from scripts/dev-keys.sh of multi-tour-infra-postgres; in qa and main,
# from the secrets of the environment.

# HTTP (guidelines 1.1: security listens on 8086)
HTTP_PORT=8086

# Database: the service connects as security_app, never as the instance administrator
DATABASE_URL=postgres://security_app:<SECURITY_APP_PASSWORD>@postgres:5432/multitour
# Read by the tests and the CI only
TEST_DATABASE_URL=

# Tokens: the private key signs, the public one validates (RS256 only)
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=

# Credential e-mail (ADR-004 D3). In development: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_REQUIRE_TLS=false and
# COMPOSE_PROFILES=mail-capture in env/dev.env. In qa and main: the provider of the environment, with TLS required.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
# Where the pages of the portal live; the link of the e-mail is built from it
PUBLIC_BASE_URL=

# E-mail of the first Platform Administrator, read only by the bootstrap-platform-admin command
PLATFORM_ADMIN_EMAIL=

# Read by deploy/compose.yml in the root composition (env/<environment>.env of multi-tour-infra-postgres)
# SECURITY_APP_PASSWORD: password of security_app, used in DATABASE_URL
# JWT_KEYS_DIR: host directory with private.pem and public.pem, mounted read only at /run/keys
SECURITY_APP_PASSWORD=
JWT_KEYS_DIR=
