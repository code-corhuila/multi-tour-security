# Copy to .env, which is never versioned, and fill every secret. Names and placeholders only.
# In development the keys come from scripts/dev-keys.sh of multi-tour-infra-postgres; in qa and main,
# from the secrets of the environment.

# HTTP (guidelines 1.1: security listens on 8086)
HTTP_PORT=8086

# Database: the service connects as security_app, never as the instance administrator
DATABASE_URL=postgres://security_app:<SECURITY_APP_PASSWORD>@postgres:5432/multitour
# Read by the tests and the CI only
TEST_DATABASE_URL=

# Tokens: the private key signs, the public one validates (RS256 only)
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=

# Credential e-mail (Mailpit in development): reserved, no code reads these yet
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# E-mail of the first Platform Administrator, read only by the bootstrap-platform-admin command
PLATFORM_ADMIN_EMAIL=
